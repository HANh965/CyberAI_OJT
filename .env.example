# ==============================================================================
# CyberAI_OJT - Environment Configuration Template
# Copy this file to .env and fill in your credentials.
# ==============================================================================

# 1. Google Gemini (Recommended - Fast & Free via Google AI Studio)
# Get your API key at: https://aistudio.google.com/
GEMINI_API_KEY=""

# 2. Default Model Selection
# Examples:
#   - Cloud: gemini/gemini-3.5-flash, gemini/gemini-2.5-flash, gemini/gemini-3.1-flash-lite
#   - Local Ollama: ollama/qwen2.5:7b, ollama/llama3.1:8b
CAI_MODEL="gemini/gemini-3.5-flash"

# 3. Ollama Configuration (For offline / private LLM execution)
# - On Linux Native: http://localhost:11434
# - On WSL2 Ubuntu connecting to Windows host: http://localhost:11434 (or Windows Gateway IP)
OLLAMA_HOST="http://localhost:11434"
OLLAMA_API_BASE="http://localhost:11434"

# 4. Optional Cloud Provider Keys
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# 5. Core Engine & Terminal Preferences
PROMPT_TOOLKIT_NO_CPR=1
CAI_STREAM=false

# 6. Pentest & Security Lab Settings
# Set to true ONLY when running authorized internal pentests or local CTF labs.
# Allows testing localhost / 127.0.0.1 / private networks.
CAI_FETCH_ALLOW_INTERNAL=true